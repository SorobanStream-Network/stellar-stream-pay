  "description": "SQLite-backed event indexer & Express API for StellarStream-Pay — persists contract events and serves stream state to the frontend.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
