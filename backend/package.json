  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.3",
    "zod": "^4.6.7"
