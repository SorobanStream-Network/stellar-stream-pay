# Copy to .env and adjust. All values shown are Testnet defaults.
PORT=4000

# Soroban RPC (reads contract storage) and Horizon (reads classic balances).
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# The deployed StreamingContract instance id (C...). Fill in after
# `stellar contract deploy` — the stream endpoints return 400 until set.
STREAM_CONTRACT_ID=
