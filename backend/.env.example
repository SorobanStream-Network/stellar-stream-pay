# Copy to .env and adjust. All values shown are Testnet defaults.
PORT=4000

# Soroban RPC (reads contract storage) and Horizon (reads classic balances).
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# The deployed StreamingContract instance id (C...). Fill in after
# `stellar contract deploy` — the stream endpoints return 400 until set.
STREAM_CONTRACT_ID=

# --- TTL keeper / relayer (optional) ---
# stream-core's permissionless `bump` / `bump_instance` entrypoints keep the
# contract instance, Wasm code, and stream entries from being archived. Any
# FUNDED account works — the calls only pay gas. Run `npm run keeper`
# (long-running scheduler) or `npm run keeper:once` (single pass, for cron).
# Leave unset to run the API only; the keeper process refuses to start.
KEEPER_SECRET=
# Pass cadence in minutes (default 1440 = daily).
KEEPER_INTERVAL_MIN=1440
# Bump a stream when its remaining TTL is below this many ledgers
# (ledgers close ~every 5s; 518400 = 30 days). Default 518400.
KEEPER_TTL_THRESHOLD=518400
# Stream ids per `bump_many` call (clamped to the contract's cap of 32).
# Larger batches = fewer transactions but a bigger per-tx footprint; if a
# batch fails, the keeper falls back to per-stream bumps automatically.
KEEPER_BUMP_BATCH=4
# Monitoring: a tiny HTTP endpoint (scheduler mode only) exposing the last
# pass result — GET /health (liveness) and GET /status (last pass, failures,
# next pass). Set port to 0 to disable; bind 0.0.0.0 for container/k8s probes.
KEEPER_HEALTH_PORT=4300
KEEPER_HEALTH_HOST=127.0.0.1
# Network passphrase the keeper signs for (default Testnet).
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
